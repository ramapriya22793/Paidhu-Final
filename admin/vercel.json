{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://paidhu-final-anm2.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|manifest\\.json|robots\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

