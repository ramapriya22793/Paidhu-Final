# ==========================================
# PAIDHU DOCKER ENVIRONMENT CONFIGURATION
# ==========================================

# ── Port Configurations ──
FRONTEND_PORT=80
ADMIN_PORT=8080
BACKEND_PORT=5000

# ── Database Connection (Supabase PostgreSQL / AWS RDS) ──
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# ── Supabase Configuration ──
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# ── Authentication / JWT ──
JWT_SECRET=super_secret_jwt_key_change_me_in_production
ADMIN_EMAIL=admin@paidhuethicalfoods.com
ADMIN_PASSWORD=AdminSecurePassword123!

# ── Payment Gateway (Razorpay) ──
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ── Frontend & Admin Build Args ──
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# ── Email Notifications (SMTP / Gmail) ──
EMAIL_USER=orders@paidhuethicalfoods.com
EMAIL_PASSWORD=app_password_here
